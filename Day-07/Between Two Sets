def getTotalX(a, b):
    count = 0 
    
    for num in range(max(a),min(b)+1):
        
        
        valid = True
        
        for i in a:
            
            if num % i != 0 :
                
                valid = False
                break
            
        if valid:
            for j in b:
                if j%num !=0:
                    valid = False
                    break
        if valid:
            count+=1      
                        
    return count
